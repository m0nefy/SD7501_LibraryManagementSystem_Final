@model Category
@{ ViewData["Title"] = "Delete category"; }<div class="form-shell">
  <p class="eyebrow">CONFIRM ACTION</p>
  <h1>Delete @Model.Name?</h1>
  <p class="text-muted">This action is only allowed when the category has no books.</p>
  <form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button class="btn btn-danger">Delete category</button> <a asp-action="Index" class="btn btn-link">Cancel</a>
  </form>
</div>
