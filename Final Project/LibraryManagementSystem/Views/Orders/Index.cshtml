@model IEnumerable<BorrowingOrder>
@{
    ViewData["Title"] = "My orders";
    var readerName = (string?)ViewBag.ReaderName ?? string.Empty;
}

<h1 class="section-title">My borrowing orders</h1>
@if (!Model.Any())
{
    <div class="alert alert-info">No orders were found for this reader.</div>
}
@foreach (var order in Model)
{
    <div class="card mb-3 p-3">
        <div class="d-flex justify-content-between flex-wrap gap-2">
            <div><strong>Order #@order.Id</strong><br /><small class="text-muted">Created @order.CreatedAt.ToString("yyyy-MM-dd") · Due @order.DueDate.ToString("yyyy-MM-dd")</small></div>
            <span class="badge text-bg-secondary align-self-start">@order.Status</span>
        </div>
        <ul class="mt-3 mb-2">
        @foreach (var item in order.Items)
        {
                    <li>
                @(item.Book?.Title ?? item.BookTitle ?? "Deleted book") × @item.Quantity <span class="text-muted">(due @((item.DueDate ?? order.DueDate).ToString("yyyy-MM-dd")))</span>
                @if (item.ReturnedQuantity > 0 || item.RejectedQuantity > 0)
                {
                    <span class="text-muted">(returned @item.ReturnedQuantity, rejected @item.RejectedQuantity)</span>
                }
            </li>
        }
        </ul>
        <div class="small text-muted mb-2">Borrowing fee: @order.BorrowingFee.ToString("C") · Fine: @order.FineAmount.ToString("C") · Book charge: @order.BookChargeAmount.ToString("C")</div>
        @if (order.Status == OrderStatus.Borrowing || order.Status == OrderStatus.Overdue)
        {
            <form asp-action="RequestReturn" method="post" class="border rounded p-3 mb-2">
                <input type="hidden" name="id" value="@order.Id" />
                <div class="small text-muted mb-2">Select the books and quantities you want to return now.</div>
                <div class="row g-2 align-items-end">
                @foreach (var item in order.Items.Where(i => i.Quantity - i.ReturnedQuantity - i.RejectedQuantity > 0))
                {
                    var outstanding = item.Quantity - item.ReturnedQuantity - item.RejectedQuantity;
                    <div class="col-md-4">
                        <label class="form-label small">@(item.Book?.Title ?? item.BookTitle ?? "Deleted book") (max @outstanding)</label>
                        <input class="form-control form-control-sm" type="number" name="returnQuantities[@item.Id]" min="0" max="@outstanding" value="0" />
                    </div>
                }
                </div>
                <button class="btn btn-outline-primary btn-sm mt-2">Request selected return</button>
            </form>
        }
        @if (order.Status == OrderStatus.ReturnRequested)
        {
            <div class="alert alert-info">Return request is waiting for librarian review.</div>
        }
        @if (order.Status == OrderStatus.Overdue || order.Status == OrderStatus.ReturnRequested)
        {
            var paidFine = order.Payments.Where(p => p.Type == PaymentType.Fine).Sum(p => p.Amount);
            @if (order.FineAmount > paidFine)
            {
                <form asp-action="PayFine" method="post" class="d-inline ms-2">
                    <input type="hidden" name="id" value="@order.Id" />
                    <button class="btn btn-warning btn-sm">Pay fine</button>
                </form>
            }
        }
        @if (order.Status == OrderStatus.ReturnRejected)
        {
            <div class="alert alert-warning mt-2 mb-2">Return rejected: @order.RejectionReason. Pay the book charge to close this order.</div>
            <form asp-action="PayBookCharge" method="post">
                <input type="hidden" name="id" value="@order.Id" />
                <button class="btn btn-danger btn-sm">Pay book charge</button>
            </form>
        }
    </div>
}
