@model IEnumerable<Book>
  @{ ViewData["Title"] = "Manage books"; }<div class="page-heading">
    <div>
      <p class="eyebrow">ADMINISTRATION</p>
      <h1>Books</h1>
      <p class="text-muted">Maintain book information and monitor stock.</p>
    </div>
  <a asp-action="Create" class="btn btn-primary">+ Add book</a>
</div>
<div class="table-card">
  <table class="table align-middle mb-0">
    <thead>
      <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Category</th>
        <th>Stock</th>
        <th>
        </th>
    </tr>
</thead>
<tbody>@foreach (var b in Model) { <tr>
    <td class="fw-semibold">@b.Title<br />
      <small class="text-muted">@b.ISBN</small>
    </td>
  <td>@b.Author</td>
  <td>
    <span class="badge-soft">@b.Category?.Name</span>
  </td>
<td>@b.AvailableCopies / @b.TotalCopies</td>
<td class="text-end">
  <a asp-action="Edit" asp-route-id="@b.Id">Edit</a> 
  <a class="ms-3 text-danger" asp-action="Delete" asp-route-id="@b.Id">Delete</a>
</td>
</tr>}</tbody>
</table>
</div>
